# Reference for /srv/melrater/.env, which is written ON THE SERVER (deploy.md
# §1.7) and never copied there — the box only receives compose.yaml and Caddyfile.
# Never commit a filled-in copy: .gitignore excludes .env and .env.* for this
# reason, and compose reads .env from whatever directory you run it in.

# Generate with: openssl rand -base64 48
# Keep it stable — changing it invalidates every session and logs everyone out.
MELRATER_SECRET_KEY=

# The address reviewers type. One value feeds four settings that must agree:
# ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS, the Caddy site address and default_sni.
# Kept across rebuilds as a Hetzner Primary IP — see deploy.md §1.2.
MELRATER_HOST=2.29.21.207
