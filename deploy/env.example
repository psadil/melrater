# Reference for /srv/melrater/.env, which is written ON THE SERVER (see "The
# .env file" in the README) and never copied there — the box only receives
# compose.yaml (TLS/routing config belongs to the proxy repo).
# Never commit a filled-in copy: .gitignore excludes .env and .env.* for this
# reason, and compose reads .env from whatever directory you run it in.

# Generate with: openssl rand -base64 48
# Keep it stable — changing it invalidates every session and logs everyone out.
MELRATER_SECRET_KEY=

# The address reviewers type. Feeds ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS,
# and must agree with PROXY_HOST in /srv/proxy/.env (the Caddy site address
# and default_sni).
# Read off the cloud metadata service rather than typed, and kept across
# rebuilds as a Hetzner Primary IP — see "The .env file" in the README.
MELRATER_HOST=
